# Privy — wallet / social login (get App ID from privy.io dashboard)
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id

# Supabase — use the Transaction pooler URL (port 6543) for Vercel serverless
# Project Settings → Database → Connection string → Transaction pooler
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-xxx.pooler.supabase.com:6543/postgres

# Board contracts (Robinhood Chain testnet — v2 with RewardAccounting)
NEXT_PUBLIC_BOARD_ADDRESS=0x6A57Ff5C1d105941c8A6CcCC681F37B1FED9733E
NEXT_PUBLIC_REWARD_ACCOUNTING_ADDRESS=0xf51FAACD5a76Bf315a9473FcE549a49B2fe3cb78
NEXT_PUBLIC_CHAIN_ID=46630
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Indexer cron — set a random secret, add to cron-job.org as Authorization header
INDEXER_SECRET=change-me-to-a-random-string
RPC_URL=https://rpc.testnet.chain.robinhood.com
DEPLOYMENT_BLOCK=98751649
