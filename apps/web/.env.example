# Privy — wallet / social login (get App ID from privy.io dashboard)
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id

# Supabase — use the Transaction pooler URL (port 6543) for Vercel serverless
# Project Settings → Database → Connection string → Transaction pooler
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-xxx.pooler.supabase.com:6543/postgres

# Board contracts (Robinhood Chain mainnet — chain ID 4663)
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_BOARD_ADDRESS=0x...           # Board_v2 mainnet address (set after deploy)
NEXT_PUBLIC_REWARD_ACCOUNTING_ADDRESS=0x... # RewardAccounting mainnet address
NEXT_PUBLIC_BOARD_VAULT_ADDRESS=0x...      # BoardVault mainnet address
NEXT_PUBLIC_BOARD_REGISTRY_ADDRESS=0x...   # BoardRegistry mainnet address
NEXT_PUBLIC_MOCK_STRATEGY_ADDRESS=0x...    # MockStrategyAdapter mainnet address
NEXT_PUBLIC_USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168  # Paxos USDG mainnet

# Indexer cron — set a strong random secret (32+ chars), add to cron-job.org as Authorization header
INDEXER_SECRET=replace-with-strong-random-secret
RPC_URL=https://rpc.mainnet.chain.robinhood.com
DEPLOYMENT_BLOCK=0                          # Set to actual mainnet deployment block after deploy

# Admin simulator gate — comma-separated wallet addresses that can access /admin/simulator
NEXT_PUBLIC_ADMIN_WALLETS=0x...

# Optional: testnet overrides (for local dev against testnet)
# NEXT_PUBLIC_CHAIN_ID=46630
# NEXT_PUBLIC_RPC_URL=https://rpc.testnet.chain.robinhood.com
# RPC_URL=https://rpc.testnet.chain.robinhood.com
