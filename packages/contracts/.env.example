# ── Mainnet deployment (Robinhood Chain — chain ID 4663) ─────────────────────
DEPLOYER_PRIVATE_KEY=0x...          # Funded mainnet wallet private key
TREASURY=0x...                      # Address to receive protocol fees (5% of takeovers)

# Optional overrides
ADMIN=                              # Defaults to deployer
ROBINHOOD_MAINNET_RPC=https://rpc.mainnet.chain.robinhood.com
SETTLEMENT_ASSET=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168  # Mainnet USDG (Paxos)
VACANT_SEAT_PRICE=10000000          # 10 USDG (6 decimals)
STREAM_DURATION=604800              # 7-day reward smoothing window

