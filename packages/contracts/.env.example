# Robinhood Chain Testnet Deployment
# Copy to .env and fill in values. NEVER commit .env to git.

# Required
DEPLOYER_PRIVATE_KEY=0x...          # Funded testnet wallet private key
TREASURY=0x...                      # Address to receive protocol fees

# Optional overrides
ADMIN=                              # Defaults to deployer
ROBINHOOD_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com
SETTLEMENT_ASSET=0x7E955252E15c84f5768B83c41a71F9eba181802F  # Testnet USDG
VACANT_SEAT_PRICE=10000000          # 10 USDG (6 decimals)

# Set to "true" to deploy MockUSDC instead of using testnet USDG
DEPLOY_MOCK_USDC=false

# Explorer verification (optional)
BLOCKSCOUT_API_KEY=verifyContract
